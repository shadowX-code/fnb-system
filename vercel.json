{
  "routes": [
    {
      "src": "/privacy/?",
      "dest": "/privacy.html",
      "has": [
        {
          "type": "host",
          "value": "feedx.my"
        }
      ]
    },
    {
      "src": "/privacy.html",
      "missing": [
        {
          "type": "host",
          "value": "feedx.my"
        }
      ],
      "dest": "/index.html"
    },
    {
      "src": "/assets/[^/]+-[A-Za-z0-9_-]{8}\\.(js|css)$",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/assets/.*",
      "status": 404,
      "headers": {
        "Cache-Control": "no-store"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "functions": {
    "api/marketing-creator-inspect.mjs": {
      "includeFiles": "node_modules/@sparticuz/chromium/bin/**",
      "maxDuration": 60
    }
  }
}
