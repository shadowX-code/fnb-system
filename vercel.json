{
  "routes": [
    {
      "src": "/privacy/?",
      "dest": "/privacy.html",
      "has": [
        {
          "type": "host",
          "value": "feedx.my"
        }
      ]
    },
    {
      "src": "/privacy.html",
      "missing": [
        {
          "type": "host",
          "value": "feedx.my"
        }
      ],
      "dest": "/index.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
