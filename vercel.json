{
  "routes": [
    {
      "src": "/open-source/jarvis/(.*)",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Cross-Origin-Resource-Policy": "cross-origin",
        "X-Content-Type-Options": "nosniff",
        "Content-Security-Policy": "default-src 'none'; script-src 'self' https://fnb-system-staging.vercel.app/open-source/jarvis/ 'unsafe-inline'; style-src 'self' https://fnb-system-staging.vercel.app/open-source/jarvis/ 'unsafe-inline'; font-src 'self' https://fnb-system-staging.vercel.app/open-source/jarvis/; img-src 'self' data:; connect-src 'none'; media-src 'none'; object-src 'none'; worker-src 'none'; frame-ancestors https://fnb-system-staging.vercel.app; form-action 'none'; base-uri 'self'",
        "Cache-Control": "no-cache"
      },
      "continue": true
    },
    {
      "src": "/privacy/?",
      "dest": "/privacy.html",
      "has": [
        {
          "type": "host",
          "value": "(feedx\\.my|fnb-system-staging\\.vercel\\.app)"
        }
      ]
    },
    {
      "src": "/privacy.html",
      "missing": [
        {
          "type": "host",
          "value": "(feedx\\.my|fnb-system-staging\\.vercel\\.app)"
        }
      ],
      "dest": "/index.html"
    },
    {
      "src": "/assets/[^/]+-[A-Za-z0-9_-]{8}\\.(js|css)$",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/assets/.*",
      "status": 404,
      "headers": {
        "Cache-Control": "no-store"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "functions": {
    "api/marketing-creator-inspect.mjs": {
      "includeFiles": "node_modules/@sparticuz/chromium/bin/**",
      "maxDuration": 60
    }
  }
}
